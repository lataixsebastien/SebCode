{
    "name": "sebcode/sebcode",
    "description": "Console-first local coding agent bootstrap built with Symfony Console 8.1.",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": "^8.4",
        "ext-ctype": "*",
        "ext-iconv": "*",
        "ext-pdo_sqlite": "*",
        "symfony/console": "8.1.*"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.95",
        "phpstan/phpstan": "^2.2",
        "phpunit/phpunit": "^11.5.55"
    },
    "config": {
        "sort-packages": true
    },
    "autoload": {
        "psr-4": {
            "SebCode\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "SebCode\\Tests\\": "tests/"
        }
    },
    "bin": [
        "bin/sebcode"
    ],
    "scripts": {
        "test": "vendor/bin/phpunit",
        "test:unit": "vendor/bin/phpunit --testsuite Unit",
        "test:security": "vendor/bin/phpunit --testsuite Security",
        "stan": "vendor/bin/phpstan analyse -c phpstan.dist.neon --memory-limit=512M",
        "cs": "vendor/bin/php-cs-fixer fix --dry-run --diff --config=.php-cs-fixer.dist.php",
        "cs:fix": "vendor/bin/php-cs-fixer fix --config=.php-cs-fixer.dist.php",
        "qa": [
            "@cs",
            "@stan",
            "@test"
        ]
    }
}
